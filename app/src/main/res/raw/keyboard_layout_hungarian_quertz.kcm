map key 45 X
map key 46 C
map key 47 V
map key 48 B
map key 49 N
map key 50 M
map key 51 COMMA
map key 52 PERIOD
map key 53 SLASH
map key 57 SPACE
map key 86 PLUS
map key 95 NUMPAD_COMMA

key 1 {
  label: '1'
  base: '1'
  shift: '\u0021'  # Exclamation mark (!)
  capslock+shift: '\u0021'
  ralt: '\u007e'  # Tilde (~)
}

key 2 {
  label: '2'
  base: '2'
  shift: '\u0022'  # Quotation mark (")
  capslock+shift: '\u0022'
  ralt: '\u0040'  # At symbol (@)
}

key 3 {
  label: '3'
  base: '3'
  shift: '\u00a7'  # Section sign (§)
  capslock+shift: '\u00a7'
  ralt: '\u0023'  # Hash (#)
}

key 4 {
  label: '4'
  base: '4'
  shift: '\u0024'  # Dollar sign ($)
  capslock+shift: '\u0024'
  ralt: '\u00a4'  # Currency sign (¤)
}

key 5 {
  label: '5'
  base: '5'
  shift: '\u0025'  # Percent sign (%)
  capslock+shift: '\u0025'
  ralt: '\u20ac'  # Euro sign (€)
}

key 6 {
  label: '6'
  base: '6'
  shift: '\u002f'  # Slash (/)
  capslock+shift: '\u002f'
  ralt: '\u007c'  # Vertical bar (|)
}

key 7 {
  label: '7'
  base: '7'
  shift: '\u003d'  # Equals sign (=)
  capslock+shift: '\u003d'
  ralt: '\u00b4'  # Acute accent (´)
}

key 8 {
  label: '8'
  base: '8'
  shift: '\u0028'  # Left parenthesis (()
  capslock+shift: '\u0028'
  ralt: '\u0028'  # Left parenthesis (()
}

key 9 {
  label: '9'
  base: '9'
  shift: '\u0029'  # Right parenthesis ())
  capslock+shift: '\u0029'
  ralt: '\u0029'  # Right parenthesis ())
}

key 0 {
  label: '0'
  base: '0'
  shift: '\u00f6'  # O with diaeresis (ö)
  capslock: '\u00d6'  # O with diaeresis (Ö)
  capslock+shift: '\u00f6'
  ralt: '\u005b'  # Left square bracket ([)
}

key MINUS {
  label: '\u00fc'  # U with diaeresis (ü)
  base: '\u00fc'
  shift: '\u00dc'  # U with diaeresis (Ü)
  capslock: '\u00dc'
  capslock+shift: '\u00fc'
  ralt: '\u005d'  # Right square bracket (])
}

key EQUALS {
  label: '\u00f3'  # O with acute accent (ó)
  base: '\u00f3'
  shift: '\u00d3'  # O with acute accent (Ó)
  capslock: '\u00d3'
  capslock+shift: '\u00f3'
  ralt: '\u005c'  # Backslash (\)
}

key Q {
  label: 'q'
  base: 'q'
  shift: 'Q'
  capslock: 'Q'
  capslock+shift: 'q'
}

key W {
  label: 'w'
  base: 'w'
  shift: 'W'
  capslock: 'W'
  capslock+shift: 'w'
}

key E {
  label: 'e'
  base: 'e'
  shift: 'E'
  capslock: 'E'
  capslock+shift: 'e'
  ralt: '\u00c9'  # E with acute accent (É)
}

