  label: 'o'
  base: 'o'
  shift: 'O'
  capslock: 'O'
  capslock+shift: 'o'
  ralt: '\u00d3'  # O with acute accent (Ó)
}

key P {
  label: 'p'
  base: 'p'
  shift: 'P'
  capslock: 'P'
  capslock+shift: 'p'
}

key LEFT_BRACKET {
  label: '\u0151'  # O with double acute accent (ő)
  base: '\u0151'
  shift: '\u0150'  # O with double acute accent (Ő)
  capslock: '\u0150'
  capslock+shift: '\u0151'
  ralt: '\u00f7'  # Division sign (÷)
}

key RIGHT_BRACKET {
  label: '\u00fa'  # U with acute accent (ú)
  base: '\u00fa'
  shift: '\u00da'  # U with acute accent (Ú)
  capslock: '\u00da'
  capslock+shift: '\u00fa'
  ralt: '\u00d7'  # Multiplication sign (×)
}

key A {
  label: 'a'
  base: 'a'
  shift: 'A'
  capslock: 'A'
  capslock+shift: 'a'
  ralt: '\u00e1'  # A with acute accent (á)
}

