  capslock: '\u00cd'
  capslock+shift: '\u00ed'
  ralt: '\u005e'  # Caret (^)
}

key BACKSLASH {
  label: '\u0171'  # U with double acute accent (ű)
  base: '\u0171'
  shift: '\u0170'  # U with double acute accent (Ű)
  capslock: '\u0170'
  capslock+shift: '\u0171'
