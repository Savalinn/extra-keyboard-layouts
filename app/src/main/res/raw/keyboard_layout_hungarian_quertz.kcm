key PLUS {
  label: '\u00fa'  # U with acute accent (ú)
  base: '\u00fa'
  shift: '\u00da'  # U with acute accent (Ú)
  capslock: '\u00da'
  capslock+shift: '\u00fa'
  ralt: '\u003c'  # Less-than sign (<)
}

key NUMPAD_COMMA {
  label: '\u002c'  # Comma (,)
  base: '\u002c'
  shift: '\u002c'
  capslock+shift: '\u002c'
}
