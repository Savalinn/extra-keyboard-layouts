key COMMA {
  label: '\u002c'  # Comma (,)
  base: '\u002c'
  shift: '\u003f'  # Question mark (?)
  capslock+shift: '\u003f'
}

key PERIOD {
  label: '\u002e'  # Period (.)
  base: '\u002e'
  shift: '\u003a'  # Colon (:)
  capslock+shift: '\u003a'
}

key SLASH {
  label: '\u002d'  # Hyphen (-)
  base: '\u002d'
  shift: '\u005f'  # Underscore (_)
